:80 {
	# Copilot proxy debug endpoint
	handle /copilot-debug/* {
		reverse_proxy 127.0.0.1:18791 {
			rewrite /debug/last-request
		}
	}

	# MCP bridge on a distinct path (for CrabTalk/external access)
	handle_path /mcp-bridge/* {
		reverse_proxy 127.0.0.1:8081
	}

	handle_path /internal/* {
		reverse_proxy 127.0.0.1:8081
	}

	# Everything else goes to OpenChamber UI
	handle /* {
		reverse_proxy 127.0.0.1:3000 {
			flush_interval -1
			header_down -Content-Security-Policy
		}
	}
}
