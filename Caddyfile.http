:80 {
	handle /health {
		respond "ok" 200
	}

	# MCP bridge on a distinct path (for CrabTalk/external access)
	handle_path /mcp-bridge/* {
		reverse_proxy 127.0.0.1:8081
	}

	handle_path /internal/* {
		reverse_proxy 127.0.0.1:8081
	}

	# OpenCode real-time events (WebSocket + SSE fallback) – bypass OpenChamber
	handle /api/event/* {
		reverse_proxy 127.0.0.1:4096 {
			flush_interval -1
		}
	}
	handle /api/event {
		reverse_proxy 127.0.0.1:4096 {
			flush_interval -1
		}
	}

	# Everything else goes to OpenChamber UI
	handle /* {
		reverse_proxy 127.0.0.1:3000 {
			flush_interval -1
			header_down -Content-Security-Policy
		}
	}
}
