{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "provider": {
    "copilot": {
      "id": "copilot",
      "name": "GitHub Copilot"
    }
  },
  "mcp": {
    "linear": {
      "type": "local",
      "command": ["/usr/bin/linear-mcp-server"],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "LINEAR_API_KEY": "{env:LINEAR_API_KEY}"
      }
    }
  }
}
