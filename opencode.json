{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "provider": {
    "copilot-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GitHub Copilot (proxy)",
      "options": {
        "baseURL": "http://127.0.0.1:18791/v1"
      },
      "models": {
        "claude-sonnet-4": {
          "name": "Claude Sonnet 4 (Copilot)"
        },
        "gpt-4o": {
          "name": "GPT-4o (Copilot)"
        },
        "o3-mini": {
          "name": "o3-mini (Copilot)"
        }
      }
    }
  },
  "mcp": {
    "linear": {
      "type": "local",
      "command": ["/usr/bin/linear-mcp-server"],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "LINEAR_API_KEY": "{env:LINEAR_API_KEY}"
      }
    }
  }
}
