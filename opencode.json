{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "provider": {
    "copilot-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GitHub Copilot (proxy)",
      "options": {
        "baseURL": "http://127.0.0.1:18791/v1"
      },
      "models": {
        "claude-sonnet-4": {
          "name": "Claude Sonnet 4 (Copilot)",
          "attachments": true,
          "toolcall": true
        },
        "claude-sonnet-4.6": {
          "name": "Claude Sonnet 4.6 (Copilot)",
          "attachments": true,
          "toolcall": true
        },
        "gpt-4o": {
          "name": "GPT-4o (Copilot)",
          "toolcall": true
        },
        "o3-mini": {
          "name": "o3-mini (Copilot)",
          "toolcall": true
        },
        "claude-opus-4.6": {
          "name": "Claude Opus 4.6 (Copilot)",
          "attachments": true,
          "toolcall": true
        }
      }
    }
  },
  "mcp": {
    "linear": {
      "type": "local",
      "command": ["node", "/app/scripts/linear-mcp.mjs"],
      "enabled": true,
      "timeout": 60000,
      "environment": {
        "LINEAR_API_KEY": "{env:LINEAR_API_KEY}",
        "LINEAR_TEAM_ID": "{env:LINEAR_TEAM_ID}"
      }
    },
    "crabcode-bridge": {
      "type": "remote",
      "url": "http://127.0.0.1:8081/mcp-root/",
      "enabled": true
    }
  }
}
