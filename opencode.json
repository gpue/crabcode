{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "provider": {},
  "mcp": {
    "linear": {
      "type": "local",
      "command": ["node", "/app/scripts/linear-mcp.mjs"],
      "enabled": true,
      "timeout": 60000,
      "environment": {
        "LINEAR_API_KEY": "{env:LINEAR_API_KEY}",
        "LINEAR_TEAM_ID": "{env:LINEAR_TEAM_ID}"
      }
    },
    "crabcode-bridge": {
      "type": "remote",
      "url": "http://127.0.0.1:8081/mcp-root/",
      "enabled": true
    }
  }
}
