{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "provider": {
    "copilot": {
      "id": "copilot",
      "name": "GitHub Copilot"
    }
  },
  "mcp": {
    "linear": {
      "type": "command",
      "command": "npx -y @jerhadf/linear-mcp-server",
      "enabled": true,
      "timeout": 15000,
      "env": {
        "LINEAR_API_KEY": "${LINEAR_API_KEY}"
      }
    }
  }
}
