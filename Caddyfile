:80 {
	handle /health {
		respond "ok" 200
	}

	# MCP bridge on a distinct path (for CrabTalk/external access)
	handle_path /mcp-bridge/* {
		reverse_proxy localhost:8081
	}

	handle_path /internal/* {
		reverse_proxy localhost:8081
	}

	# Everything else goes to OpenCode's built-in web UI
	handle /* {
		reverse_proxy localhost:4096 {
			header_down -Content-Security-Policy
		}
	}
}
