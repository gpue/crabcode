{
	# Disable Caddy's built-in ACME — certs are provided by Tailscale
	auto_https off
}

# HTTPS — served only over Tailscale; cert provisioned by `tailscale cert`
:443 {
	tls /tmp/tailscale-cert/server.crt /tmp/tailscale-cert/server.key

	# MCP bridge on a distinct path (for CrabTalk/external access)
	handle_path /mcp-bridge/* {
		reverse_proxy 127.0.0.1:8081
	}

	handle_path /internal/* {
		reverse_proxy 127.0.0.1:8081
	}

	# Everything else goes to OpenChamber UI
	handle /* {
		reverse_proxy 127.0.0.1:3000 {
			flush_interval -1
			header_down -Content-Security-Policy
		}
	}
}

# HTTP — redirect to HTTPS
:80 {
	handle {
		redir https://{host}{uri} permanent
	}
}
