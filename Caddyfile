:80 {
	handle /health {
		respond "ok" 200
	}

	handle_path /mcp/* {
		reverse_proxy localhost:8081
	}
	handle_path /mcp {
		reverse_proxy localhost:8081
	}

	handle_path /internal/* {
		reverse_proxy localhost:8081
	}

	handle /events {
		reverse_proxy localhost:8081
	}

	# Everything else goes to OpenCode's built-in web UI
	handle /* {
		reverse_proxy localhost:4096
	}
}
