# GitHub Copilot (via copilot-proxy)
# GH_TOKEN is used to exchange for a Copilot API token.
# Can also use `gh auth login` instead of setting this.
GH_TOKEN=ghp_...
COPILOT_MODEL=claude-sonnet-4

# Linear
LINEAR_API_KEY=lin_api_...
LINEAR_ASSIGNEE_ID=
LINEAR_TEAM_ID=

# Vercel
VERCEL_TOKEN=vcp_...

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_TARGET=

# Tailscale
TS_AUTHKEY=tskey-auth-...
TS_HOSTNAME=crabcode
